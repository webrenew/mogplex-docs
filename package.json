    "@openrouter/ai-sdk-provider": "^2.9.1",
    "@radix-ui/react-presence": "^1.1.10",
    "ai": "^6.0.256",
    "class-variance-authority": "^0.7.1",
    "flexsearch": "^0.8.212",
    "fumadocs-core": "16.14.5",
    "fumadocs-mdx": "15.3.0",
    "fumadocs-ui": "16.14.5",
    "geist": "^1.7.2",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-rehype": "^11.1.2",
