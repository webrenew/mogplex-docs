  "license": "Apache-2.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "gen:models": "tsx --env-file=.env.local scripts/gen-models-table.ts",
